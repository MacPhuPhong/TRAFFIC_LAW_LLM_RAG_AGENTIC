# ==== Bắt buộc ====
# Google Gemini API key (https://aistudio.google.com/apikey)
# Code tự map API_KEY -> GOOGLE_API_KEY, dùng tên nào cũng được
API_KEY=your-gemini-api-key

# Tavily API key — web search fallback (https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key

# ==== Tùy chọn ====
# Model sinh câu trả lời (mặc định: gemini-3.1-flash-lite-preview)
# GENERATOR_MODEL=gemini-3.1-flash-lite-preview

# LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=traffic-rag
